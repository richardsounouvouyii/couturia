# Contexte de build Fly = racine du monorepo
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY couturia-api/atelier-service/pyproject.toml couturia-api/atelier-service/README.md ./
COPY couturia-api/atelier-service/app ./app
COPY couturia-api/atelier-service/alembic.ini ./
COPY couturia-api/atelier-service/alembic ./alembic

RUN pip install --no-cache-dir -e .

EXPOSE 8002

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-${ATELIER_SERVICE_PORT:-8002}}"]
