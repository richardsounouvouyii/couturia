# Contexte de build Fly = racine du monorepo
# (deploy avec --config couturia-api/catalogue-service/fly.toml)
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY couturia-api/catalogue-service/pyproject.toml couturia-api/catalogue-service/README.md ./
COPY couturia-api/catalogue-service/app ./app
COPY couturia-api/catalogue-service/alembic.ini ./
COPY couturia-api/catalogue-service/alembic ./alembic

RUN pip install --no-cache-dir -e .

EXPOSE 8003

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-${CATALOGUE_SERVICE_PORT:-8003}}"]
