# Copier vers .env à la racine : copy .env.example .env

# PostgreSQL
POSTGRES_USER=couturia
POSTGRES_PASSWORD=couturia_dev
POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bases logiques par service
AUTH_DATABASE_URL=postgresql+psycopg://couturia:couturia_dev@localhost:5432/auth_db
ATELIER_DATABASE_URL=postgresql+psycopg://couturia:couturia_dev@localhost:5432/atelier_db
CATALOGUE_DATABASE_URL=postgresql+psycopg://couturia:couturia_dev@localhost:5432/catalogue_db

# RabbitMQ
RABBITMQ_USER=couturia
RABBITMQ_PASSWORD=couturia_dev
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://couturia:couturia_dev@localhost:5672/

# Auth service
AUTH_SERVICE_PORT=8001
AUTH_JWT_SECRET=change-me-in-production-use-a-long-random-string
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRE_MINUTES=60
AUTH_APP_NAME=Couturia Auth Service
AUTH_ENV=development

# Atelier service
ATELIER_SERVICE_PORT=8002
ATELIER_APP_NAME=Couturia Atelier Service
ATELIER_ENV=development

# Catalogue service
CATALOGUE_SERVICE_PORT=8003
CATALOGUE_APP_NAME=Couturia Catalogue Service
CATALOGUE_ENV=development
